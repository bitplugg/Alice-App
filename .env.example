# ═══════════════════════════════════════════════════════════
#  Alice-App · секреты (шаблон)
#  Скопируй в .env и заполни своими значениями:
#      cp .env.example .env
#  Файл .env в .gitignore — в репозиторий не попадает.
# ═══════════════════════════════════════════════════════════

# --- подпись APK (keystore/alice.jks лежит только локально) ---
ALICE_KS_PASSWORD=
ALICE_KS_ALIAS=alice
ALICE_KS_KEY_PASSWORD=

# --- колонка ---
SPEAKER_IP=192.168.1.20
SPEAKER_PIN=

# --- Wi-Fi колонки ---
WIFI_SSID=
WIFI_PASSWORD=
